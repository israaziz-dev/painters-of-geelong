# =============================================================================
# Painters of Geelong — Apache rewrite & redirect rules
# =============================================================================

RewriteEngine On

# -----------------------------------------------------------------------------
# 1. Redirect /index.html (and any subdir /index.html) to the clean root URL.
#    Uses THE_REQUEST so the rule only fires for the original browser request
#    (preventing internal-rewrite loops).
# -----------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# -----------------------------------------------------------------------------
# 2. Force HTTPS (recommended — comment out if your host already handles this)
# -----------------------------------------------------------------------------
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# -----------------------------------------------------------------------------
# 3. Force the canonical www host (comment out if you prefer the bare apex)
# -----------------------------------------------------------------------------
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# -----------------------------------------------------------------------------
# 4. Default document — serve /index.html when the user requests /
# -----------------------------------------------------------------------------
DirectoryIndex index.html

# -----------------------------------------------------------------------------
# 5. Custom 404 page
# -----------------------------------------------------------------------------
ErrorDocument 404 /404.html

# -----------------------------------------------------------------------------
# 6. Long cache for image assets (helps Core Web Vitals / repeat-visit speed)
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType text/css   "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
</IfModule>
